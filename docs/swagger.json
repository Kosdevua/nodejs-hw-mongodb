{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "nodejs-hw-mongodb",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "description": "This is a documentation of contacts app"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080"
    }
  ],
  "tags": [
    {
      "name": "Contacts",
      "description": "Operations with contacts."
    },
    {
      "name": "Auth",
      "description": "Auth operations."
    }
  ],
  "paths": {
    "/contacts/{id}": {
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "Get contact by id",
        "operationId": "getContact",
        "description": "Get contact by id",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "example": "507f1f77bcf86cd799439011"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Get student by id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully get contact"
                    },
                    "data": {
                      "type": "object",
                      "$ref": "#/components/schemas/contact"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Contact not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 404
                    },
                    "message": {
                      "type": "string",
                      "example": "Contact not found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/contacts": {
      "post": {
        "tags": [
          "Contacts"
        ],
        "summary": "Create contact",
        "operationId": "createContact",
        "description": "Create contact",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": null,
            "schema": {
              "type": "object",
              "required": [
                "name",
                "phoneNumber",
                "contactType"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Contact name",
                  "example": "Nick Daltan"
                },
                "phoneNumber": {
                  "type": "string",
                  "description": "Contact phone number",
                  "example": 380973245566
                },
                "contactType": {
                  "type": "string",
                  "description": "Contact type",
                  "enum": [
                    "work",
                    "home"
                  ],
                  "example": "work"
                },
                "isFavourite": {
                  "type": "boolean",
                  "description": "Contact is favourite",
                  "example": true,
                  "default": false
                },
                "email": {
                  "type": "string",
                  "description": "Contact email",
                  "example": "name@example.com"
                },
                "photo": {
                  "type": "string",
                  "format": "binary",
                  "description": "Contact avatar"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Create a contact",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 201
                    },
                    "message": {
                      "type": "string",
                      "example": "Contact created successfully"
                    },
                    "data": {
                      "$ref": "#/components/schemas/contact"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "contact": {
        "type": "object",
        "required": [
          "_id",
          "name",
          "phoneNumber",
          "userId",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "_id": {
            "type": "string",
            "description": "Contact id",
            "example": "507f191e810c19729de860ea"
          },
          "name": {
            "type": "string",
            "description": "Contact name",
            "example": "Volodymyr Tur"
          },
          "phoneNumber": {
            "type": "string",
            "description": "Contact phone number",
            "example": 380673250880
          },
          "email": {
            "type": "string",
            "description": "Contact email",
            "example": "john.doe@example.com"
          },
          "isFavourite": {
            "type": "boolean",
            "description": "Contact is favourite",
            "example": true,
            "default": false
          },
          "contactType": {
            "type": "string",
            "description": "Contact type",
            "enum": [
              "work",
              "home"
            ],
            "example": "home"
          },
          "userId": {
            "type": "string",
            "description": "Contact owner id",
            "example": "507f191e810c19729de860ea"
          },
          "photo": {
            "type": "string",
            "format": "url",
            "description": "Contact avatar url",
            "example": "https://res.cloudinary.com/da0i52xig/image/upload/v1750003633/v02yx9z167auidxqc7ur.png"
          },
          "createdAt": {
            "type": "string",
            "format": "data-time",
            "description": "Contact created at",
            "example": "2025-06-15T16:07:14.427+00:00"
          },
          "updatedAt": {
            "type": "string",
            "format": "data-time",
            "description": "Contact updated at",
            "example": "2025-06-16T16:07:14.427+00:00"
          }
        }
      }
    }
  }
}